# Repository-wide ignore rules.
#
# Both projects are built with Gradle and keep their own .gitignore for anything
# project-specific (see forge/.gitignore and fabric/mc1.21.11/.gitignore).

# Note: these patterns have no leading slash, so they match at any depth. Both projects build
# inside their own directory, so forge/build, fabric/mc1.21.11/build and the Gradle caches are
# all covered here.

# Gradle
build/
.gradle/
out/
classes/

# IDE
.idea/
*.iml
*.ipr
*.iws
.settings/
.classpath
.project

# Running
run/
run-data/
logs/
*.launch

# Java crash dumps
hs_err_*.log
replay_*.log
*.hprof
*.jfr

# macOS
*.DS_Store

# Optional compile-time dependency jars (see fabric/mc1.21.11/libs/README.md and
# forge/gradle/jade/README.md). Third-party mod jars are not redistributed here.
libs/*.jar
gradle/jade/*.jar
